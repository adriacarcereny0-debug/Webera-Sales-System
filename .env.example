# ─────────────────────────────────────────────────────────────
# Webera Sales System · variables de entorno
# Copia este archivo a .env.local (desarrollo) o configúralas en Vercel.
# Ninguna variable lleva NEXT_PUBLIC_: ninguna llega al navegador.
# ─────────────────────────────────────────────────────────────

# OBLIGATORIA. PostgreSQL 14 o superior (Neon, Railway, Vercel Postgres, servidor propio…).
# El usuario debe poder crear roles (CREATE ROLE) para el rol restringido webera_app.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/basededatos?sslmode=require
# Opcional: fuerza SSL si la URL no lleva sslmode=require (true/false)
# DATABASE_SSL=true
# Opcional: conexiones máximas por instancia (por defecto 5). En serverless usa el pooler del proveedor.
# DATABASE_POOL_MAX=5

# OBLIGATORIA en producción. 32+ caracteres aleatorios. Firma sesiones y tokens antispam.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# OBLIGATORIA en producción. URL pública, sin barra final (enlaces de los emails y código del formulario).
APP_URL=https://ventas.tudominio.es

# Recomendada. Protege /api/cron/automations. Vercel Cron la envía automáticamente.
CRON_SECRET=

# ── Email (opcional; sin él, los avisos quedan registrados como «No enviado») ──
# resend | smtp
EMAIL_PROVIDER=
# Remitente verificado en el proveedor, p. ej. "Avisos <avisos@tudominio.es>"
EMAIL_FROM=
# Si EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Si EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true para el puerto 465 (SSL directo); false para 587 (STARTTLS)
SMTP_SECURE=false

# ── Solo scripts ──
# Contraseña de los tres usuarios de la demo (npm run db:seed-demo). Si falta, se genera una.
# DEMO_PASSWORD=
